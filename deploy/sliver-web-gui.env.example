# Configuration for the sliver-web-gui systemd unit.
# Install to /etc/default/sliver-web-gui, then: systemctl restart sliver-web-gui
#
# This file may contain a password — keep it mode 0600, owned by root.

# Listen address for the web UI, host:port. Default is 127.0.0.1:4443.
# Change the port here if 4443 is taken or you just prefer another:
WEBGUI_ADDR=127.0.0.1:4443

# Extra flags, word-split into separate arguments.
#
# Binding anything other than localhost REQUIRES -password — the server refuses
# to start otherwise, because this UI controls a C2 server. Basic auth is sent
# in clear text, so put TLS in front of it (nginx/caddy) or tunnel over SSH
# rather than exposing it directly:
#     ssh -L 4443:127.0.0.1:4443 operator@host
#
#WEBGUI_OPTS=-password changeme
